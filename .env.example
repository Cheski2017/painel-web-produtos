# --- Conexão com a API RP Services ------------------------------------------
# Isso aqui é só um modelo. Na prática, depois de instalado, o usuário/senha
# e o endereço da API são configurados pela própria tela de login do painel
# (ícone de engrenagem) - não precisa editar este arquivo à mão para isso.
# Esses valores abaixo só servem de PONTO DE PARTIDA (são copiados para
# data/config.json na primeira vez que o servidor sobe) e para configurações
# avançadas que não têm tela própria (TLS, porta, etc.).
RP_BASE_URL=
RP_USUARIO=
RP_SENHA=

# Defina como "false" apenas se a API usar certificado autoassinado/CA interna
# e você confiar na rede (ex: acessando via VPN da empresa). Deixe "true" por
# padrão.
RP_TLS_REJECT_UNAUTHORIZED=true

# --- Lojas exibidas por padrão -----------------------------------------------
# Códigos de unidade (loja) a exibir por padrão nos seletores do painel,
# separados por vírgula. Se deixar vazio, o painel deixa você escolher a
# unidade na tela.
RP_UNIDADES=

# --- Servidor do painel -------------------------------------------------------
PORT=3000
REFRESH_INTERVAL_MINUTES=5
CACHE_TTL_SECONDS=300
